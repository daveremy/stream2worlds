data: {"changelog_kind":"insert","page_change_kind":"create","dt":"2026-09-27T16:17:21Z","wiki_id":"arwiki","page":{"page_id":10523608,"page_title":"مستخدم:Rokayia_mohammed/ملعب2","namespace_id":2,"is_redirect":false,"namespace_is_content":false},"performer":{"user_text":"Rokayia mohammed","groups":["*","user"],"is_temp":false,"wiki_id":"arwiki","first_edit_dt":"2026-09-26T15:58:03Z","user_id":3039518,"edit_count":9,"registration_dt":"2026-09-26T15:47:46Z","user_central_id":87136861,"is_bot":false,"is_system":false,"edit_global_count":9},"revision":{"rev_id":76786652,"rev_dt":"2026-09-27T16:17:21Z","is_minor_edit":false,"rev_sha1":"d8fuu0b9o1qqeom05i7wdsbfu57fwn9","rev_size":570,"rev_parent_id":0,"comment":"أنشأ الصفحة ب''''متلازمة انخفاض النتاج القلبي''' هي متلازمة قلبية وعائية عابرة ينخفض ​​فيها النتاج القلبي عن المستويات الطبيعية والمقبولة. وقد تؤدي هذه الحالة إلى نقص تروية الأنسجة وما يصاحب ذلك من أعراض. وعندما تتفاقم الحالة لتشمل خللاً في وظائف أعضاء متعددة نتيجة لنقص ا...'","is_content_visible":true,"is_editor_visible":true,"is_comment_visible":true,"editor":{"user_text":"Rokayia mohammed","groups":["*","user"],"is_temp":false,"wiki_id":"arwiki","first_edit_dt":"2026-09-26T15:58:03Z","user_id":3039518,"edit_count":9,"registration_dt":"2026-09-26T15:47:46Z","user_central_id":87136861,"is_bot":false,"is_system":false,"edit_global_count":9},"content_slots":{"main":{"slot_role":"main","content_model":"wikitext","content_sha1":"d8fuu0b9o1qqeom05i7wdsbfu57fwn9","content_size":570,"content_format":"text/x-wiki","origin_rev_id":76786652}}},"$schema":"/mediawiki/page/change/1.12.0","meta":{"stream":"mediawiki.page_change.v1","uri":"https://ar.wikipedia.org/wiki/%D9%85%D8%B3%D8%AA%D8%AE%D8%AF%D9%85:Rokayia_mohammed/%D9%85%D9%84%D8%B9%D8%A82","id":"cf1c6924-b3ca-453f-9141-7efd677a09b1","domain":"ar.wikipedia.org","request_id":"0e5467b6-6c37-4eff-b210-42de98a30ded","dt":"2026-09-27T16:17:22.881Z","topic":"eqiad.mediawiki.page_change.v1","partition":0,"offset":1109139325,"