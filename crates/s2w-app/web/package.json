{
  "name": "s2w-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.23.3" },
  "scripts": {
    "build": "node scripts/build.mjs && npm run notices",
    "notices": "node scripts/notices.mjs",
    "typecheck": "tsc --noEmit",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;ISC;BSD-2-Clause;BSD-3-Clause;0BSD'",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:licence-gate": "node scripts/test-licence-gate.mjs"
  },
  "dependencies": { "force-graph": "1.51.4" },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "license-checker-rseidelsohn": "4.4.2"
  }
}
